{
  "name": "seamly2d-mcp",
  "version": "1.0.0",
  "description": "Production-grade Model Context Protocol (MCP) server for parametric Seamly2D sewing pattern generation, measurement management, inspection, and headless CLI export.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "seamly2d-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "seamly2d",
    "sewing",
    "pattern-making",
    "cad",
    "parametric"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fast-xml-parser": "^5.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
